  "measurements": [
    {
      "definition_id": "RMSD_GLOBAL",
      "layer": "generic",
      "source": "trajectory",
      "semantic": "global_structural_deviation_after_alignment",
      "value_shape": "scalar",
      "default_unit": "nm",
      "limitations": ["Global RMSD is not a mechanism or pathogenicity score"]
    },
    {
      "definition_id": "RMSF_REGION",
      "layer": "mechanism",
      "source": "trajectory",
      "semantic": "residue_or_region_local_flexibility",
      "value_shape": "scalar",
      "default_unit": "nm",
      "limitations": ["Requires identical numbering, alignment, atom selection, and sampling"]
    },
    {
      "definition_id": "RADIUS_OF_GYRATION",
      "layer": "generic",
      "source": "trajectory",
      "semantic": "global_or_multidomain_compactness",
      "value_shape": "scalar",
      "default_unit": "nm",
      "limitations": ["Compactness alone has no subtype direction"]
    },
    {
      "definition_id": "SASA_TOTAL",
      "layer": "generic",
      "source": "trajectory",
      "semantic": "whole_construct_solvent_accessibility",
      "value_shape": "scalar",
      "default_unit": "nm2",
      "limitations": ["Whole-protein SASA can obscure local mechanistic exposure"]
    },
    {
      "definition_id": "SASA_REGION",
      "layer": "mechanism",
      "source": "trajectory",
      "semantic": "mechanism_grounded_region_solvent_accessibility",
      "value_shape": "scalar",
      "default_unit": "nm2",
      "limitations": ["SASA is geometric exposure and is not equivalent to HDX"]
    },
    {
      "definition_id": "CONTACT_OCCUPANCY",
      "layer": "mechanism",
      "source": "trajectory",
      "semantic": "fraction_of_frames_retaining_a_defined_structural_contact",
      "value_shape": "scalar",
      "default_unit": "proportion",
      "limitations": ["Depends on predeclared atom groups and distance cutoff"]
    },
    {
      "definition_id": "HBOND_OCCUPANCY",
      "layer": "mechanism",
      "source": "trajectory",
      "semantic": "hydrogen_bond_network_stability",
      "value_shape": "scalar",
      "default_unit": "proportion",
      "limitations": ["Depends on predeclared geometry and donor/acceptor selections"]
    },
    {
      "definition_id": "SALT_BRIDGE_OCCUPANCY",
      "layer": "mechanism",
      "source": "trajectory",
      "semantic": "electrostatic_network_stability",
      "value_shape": "scalar",
      "default_unit": "proportion",
      "limitations": ["Contact retention is not equivalent to binding affinity"]
    },
    {
      "definition_id": "SECONDARY_STRUCTURE_OCCUPANCY",
      "layer": "mechanism",
      "source": "trajectory_DSSP",
      "semantic": "fraction_of_frames_with_predeclared_secondary_structure",
      "value_shape": "scalar",
      "default_unit": "proportion",
      "limitations": ["DSSP occupancy is a computational surrogate for local fold integrity"]
    },
    {
      "definition_id": "PCA_CONFORMATIONAL_STATES",
      "layer": "mechanism",
      "source": "trajectory",
      "semantic": "population_and_separation_of_major_conformational_basins",
      "value_shape": "mapping",
      "default_unit": null,
      "limitations": ["PCA basis and clustering must be fitted jointly to matched trajectories"]
    },
    {
      "definition_id": "RMSD_SASA_JOINT_STATES",
      "layer": "mechanism",
      "source": "trajectory",
      "semantic": "joint_population_of_structural_deviation_and_solvent_exposure",
      "value_shape": "mapping",
      "default_unit": null,
      "limitations": ["State boundaries must be declared before case interpretation"]
    },
    {
      "definition_id": "MM_PBSA",
      "layer": "comparison",
      "source": "docked_or_MD_complex",
      "semantic": "relative_interaction_energetic_proxy",
      "value_shape": "scalar",
      "default_unit": "kcal/mol",
      "limitations": ["MM-PBSA is not an experimental Kd or an exact binding free energy"]
    }
  ],
